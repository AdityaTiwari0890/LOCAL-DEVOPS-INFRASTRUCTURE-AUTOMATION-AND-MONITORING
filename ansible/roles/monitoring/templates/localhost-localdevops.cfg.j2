###############################################################################
# Managed by Ansible: local development, testing, and production monitoring
###############################################################################

define host {
    host_name               local-devops-host
    alias                   Local Ubuntu WSL Host
    address                 127.0.0.1
    check_command           check-host-alive
    max_check_attempts      3
    check_period            24x7
    notification_period     24x7
    notification_interval   30
    notification_options    d,u,r
    contacts                nagiosadmin
}

define hostgroup {
    hostgroup_name          local-devops-hosts
    alias                   Local DevOps hosts
    members                 local-devops-host
}

define service {
    host_name               local-devops-host
    service_description     Localhost Availability
    check_command           check_ping!-w 100.0,20% -c 200.0,40%
    check_interval          1
    retry_interval          1
    max_check_attempts      3
    check_period            24x7
    notification_period     24x7
    notification_options    w,u,c,r
}

define service {
    host_name               local-devops-host
    service_description     HTTP Development
    check_command           check_http!-p 8081 -H 127.0.0.1
    check_interval          1
    retry_interval          1
    max_check_attempts      3
    check_period            24x7
    notification_period     24x7
    notification_options    w,u,c,r
}

