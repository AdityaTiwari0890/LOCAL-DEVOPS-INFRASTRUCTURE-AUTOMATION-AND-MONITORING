<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111827">
<title>NEXORA | {{ item.name | capitalize }}</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --dark: #111827;
  --muted: #6b7280;
  --accent: #6d5dfc;
  --accent-dark: #5746e8;
  --light: #f8f8fc;
  --border: #ececf2;
  --green: #159b69;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'DM Sans', sans-serif;
  color: var(--dark);
  background: white;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}

.environment {
  padding: 9px 20px;
  text-align: center;
  color: white;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  background: #159b69;
}

.environment.testing {
  background: #d97706;
}

.environment.production {
  background: #2563eb;
}

.announcement {
  background: #111827;
  color: #fff;
  text-align: center;
  padding: 10px;
  font-size: 12px;
  letter-spacing: .3px;
}

.navbar {
  height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 7%;
  border-bottom: 1px solid var(--border);
  gap: 25px;
}

.logo {
  font-family: 'Manrope', sans-serif;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -1.5px;
}

.logo span {
  color: var(--accent);
}

.nav-links {
  display: flex;
  gap: 30px;
  font-size: 13px;
  font-weight: 600;
}

.nav-links a:hover {
  color: var(--accent);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}

.icon-button {
  border: 0;
  background: transparent;
  font-size: 20px;
  padding: 8px;
  position: relative;
}

.cart-count {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--accent);
  color: white;
  font-size: 10px;
  border-radius: 50%;
  min-width: 17px;
  height: 17px;
  display: grid;
  place-items: center;
}

.mobile-menu {
  display: none;
}

.hero {
  margin: 30px 7%;
  min-height: 410px;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  align-items: center;
  background:
    linear-gradient(90deg, rgba(17,24,39,.91), rgba(17,24,39,.48), rgba(17,24,39,.04)),
    url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1800&q=85') center/cover;
  color: white;
}

.hero-content {
  padding: 55px 7%;
  max-width: 620px;
}

.hero-label {
  display: inline-block;
  color: #d6d0ff;
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 700;
  margin-bottom: 20px;
}

.hero h1 {
  font-family: 'Manrope', sans-serif;
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.1;
  letter-spacing: -2px;
  margin-bottom: 18px;
}

.hero p {
  color: #e5e7eb;
  font-size: 15px;
  line-height: 1.8;
  margin-bottom: 28px;
  max-width: 420px;
}

.primary-button {
  display: inline-block;
  background: var(--accent);
  color: white;
  padding: 14px 25px;
  border: 0;
  border-radius: 6px;
  font-weight: 700;
  font-size: 13px;
  transition: .2s;
}

.primary-button:hover {
  background: var(--accent-dark);
  transform: translateY(-2px);
}

.features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin: 35px 7% 60px;
}

.feature {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 9px;
}

.feature-icon {
  font-size: 25px;
}

.feature strong {
  display: block;
  font-size: 12px;
  margin-bottom: 4px;
}

.feature small {
  color: var(--muted);
  font-size: 10px;
}

.section {
  padding: 20px 7% 65px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 27px;
}

.eyebrow {
  color: var(--accent);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 800;
  margin-bottom: 9px;
}

.section-heading h2 {
  font-family: 'Manrope', sans-serif;
  font-size: 30px;
  letter-spacing: -1px;
}

.section-heading p {
  color: var(--muted);
  font-size: 13px;
  margin-top: 7px;
}

.search-box {
  width: 260px;
  max-width: 100%;
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 12px 14px;
  outline: none;
  font-size: 12px;
}

.search-box:focus {
  border-color: var(--accent);
}

.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 25px;
}

.category-button {
  border: 1px solid var(--border);
  background: white;
  border-radius: 30px;
  padding: 9px 17px;
  font-size: 11px;
  font-weight: 600;
  color: #4b5563;
}

.category-button.active,
.category-button:hover {
  background: var(--dark);
  color: white;
  border-color: var(--dark);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 23px;
}

.product-card {
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  background: white;
  transition: .25s;
}

.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 30px rgba(17,24,39,.08);
}

.product-image {
  position: relative;
  height: 220px;
  background: #f4f4f8;
  overflow: hidden;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .4s;
}

.product-card:hover .product-image img {
  transform: scale(1.06);
}

.product-tag {
  position: absolute;
  top: 12px;
  left: 12px;
  background: white;
  padding: 6px 9px;
  border-radius: 4px;
  font-size: 9px;
  font-weight: 800;
  color: var(--accent);
}

.product-info {
  padding: 16px;
}

.product-category {
  color: var(--muted);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.product-name {
  font-size: 14px;
  font-weight: 700;
  margin: 8px 0;
}

.rating {
  font-size: 11px;
  color: #e49a16;
  margin-bottom: 12px;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.price {
  font-weight: 800;
  font-size: 15px;
}

.old-price {
  color: #9ca3af;
  font-size: 10px;
  text-decoration: line-through;
  margin-left: 4px;
}

.add-button {
  background: var(--dark);
  color: white;
  border: 0;
  padding: 9px 12px;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 700;
}

.add-button:hover {
  background: var(--accent);
}

.no-products {
  grid-column: 1 / -1;
  text-align: center;
  padding: 50px;
  color: var(--muted);
}

.promo {
  margin: 5px 7% 70px;
  background: #eeecff;
  border-radius: 14px;
  padding: 38px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.promo h2 {
  font-family: 'Manrope', sans-serif;
  font-size: 27px;
  margin-bottom: 9px;
}

.promo p {
  color: #66627e;
  font-size: 13px;
}

.promo-code {
  background: white;
  padding: 14px 20px;
  border: 1px dashed var(--accent);
  border-radius: 7px;
  font-size: 13px;
  font-weight: 800;
  color: var(--accent);
  white-space: nowrap;
}

.footer {
  background: #111827;
  color: white;
  padding: 50px 7% 25px;
}

.footer-content {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 35px;
}

.footer h3 {
  font-size: 19px;
  margin-bottom: 15px;
}

.footer h4 {
  font-size: 13px;
  margin-bottom: 15px;
}

.footer p,
.footer a {
  color: #aeb4c1;
  font-size: 12px;
  line-height: 2;
}

.footer a {
  display: block;
}

.footer a:hover {
  color: white;
}

.footer-bottom {
  border-top: 1px solid #303746;
  padding-top: 20px;
  display: flex;
  justify-content: space-between;
  color: #9ca3af;
  font-size: 10px;
}

.overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  z-index: 20;
}

.overlay.show {
  display: block;
}

.cart-panel {
  position: fixed;
  top: 0;
  right: -440px;
  width: 420px;
  max-width: 100%;
  height: 100%;
  background: white;
  z-index: 21;
  display: flex;
  flex-direction: column;
  transition: right .3s;
}

.cart-panel.open {
  right: 0;
}

.cart-header {
  padding: 23px;
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}

.cart-header h2 {
  font-size: 19px;
}

.close-cart {
  border: 0;
  background: none;
  font-size: 23px;
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.empty-cart {
  text-align: center;
  color: var(--muted);
  padding: 65px 15px;
  font-size: 13px;
}

.cart-item {
  display: flex;
  gap: 13px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.cart-item img {
  width: 75px;
  height: 80px;
  border-radius: 6px;
  object-fit: cover;
}

.cart-item-details {
  flex: 1;
}

.cart-item-details strong {
  font-size: 12px;
  display: block;
  margin: 4px 0 8px;
}

.cart-item-details span {
  font-size: 12px;
  font-weight: 700;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 9px;
}

.quantity-controls button {
  width: 23px;
  height: 23px;
  border: 1px solid var(--border);
  background: white;
  border-radius: 4px;
}

.remove-button {
  border: 0;
  background: none;
  color: #dc2626;
  font-size: 11px;
  margin-top: 7px;
}

.cart-footer {
  padding: 22px;
  border-top: 1px solid var(--border);
}

.total-row {
  display: flex;
  justify-content: space-between;
  font-size: 15px;
  font-weight: 800;
  margin-bottom: 17px;
}

.checkout-button {
  width: 100%;
}

.cart-note {
  font-size: 10px;
  color: var(--muted);
  text-align: center;
  margin-top: 12px;
}

.toast {
  position: fixed;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: var(--dark);
  color: white;
  padding: 13px 20px;
  border-radius: 7px;
  font-size: 12px;
  z-index: 30;
  transition: .3s;
}

.toast.show {
  transform: translateX(-50%) translateY(0);
}

@media(max-width: 1000px) {
  .product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .features {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media(max-width: 700px) {
  .navbar {
    padding: 0 5%;
    height: 68px;
  }

  .nav-links {
    display: none;
  }

  .mobile-menu {
    display: inline-block;
  }

  .hero {
    margin: 18px 5%;
    min-height: 370px;
  }

  .hero-content {
    padding: 30px;
  }

  .section {
    padding-left: 5%;
    padding-right: 5%;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .search-box {
    width: 100%;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .product-image {
    height: 165px;
  }

  .product-info {
    padding: 11px;
  }

  .product-name {
    font-size: 12px;
  }

  .price {
    font-size: 12px;
  }

  .add-button {
    padding: 8px;
    font-size: 9px;
  }

  .features {
    margin-left: 5%;
    margin-right: 5%;
    gap: 9px;
  }

  .feature {
    padding: 10px;
  }

  .feature small {
    font-size: 9px;
  }

  .promo {
    margin-left: 5%;
    margin-right: 5%;
    padding: 25px;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-content {
    grid-template-columns: 1fr 1fr;
  }

  .footer-content > div:first-child {
    grid-column: 1 / -1;
  }

  .footer-bottom {
    gap: 12px;
    flex-direction: column;
  }
}

@media(max-width: 380px) {
  .product-grid {
    grid-template-columns: 1fr;
  }

  .product-image {
    height: 230px;
  }
}
</style>
</head>

<body>

<div class="environment {{ item.name }}">
  {{ item.name | upper }} ENVIRONMENT · LOCAL DEVOPS INFRASTRUCTURE
</div>

<div class="announcement">
  FREE SHIPPING ON ORDERS ABOVE ₹999 &nbsp; | &nbsp; NEW COLLECTION NOW LIVE
</div>

<header class="navbar">
  <a href="#" class="logo">NEXORA<span>.</span></a>

  <nav class="nav-links">
    <a href="#home">Home</a>
    <a href="#products">Shop</a>
    <a href="#categories">Categories</a>
    <a href="#footer">About</a>
  </nav>

  <div class="nav-actions">
    <button class="icon-button" onclick="document.getElementById('searchInput').focus()" aria-label="Search">⌕</button>
    <button class="icon-button" onclick="openCart()" aria-label="Shopping cart">
      🛒
      <span class="cart-count" id="cartCount">0</span>
    </button>
    <button class="icon-button mobile-menu" onclick="document.getElementById('products').scrollIntoView()" aria-label="Browse products">☰</button>
  </div>
</header>

<main>
<section class="hero" id="home">
  <div class="hero-content">
    <span class="hero-label">THE NEXORA COLLECTION · 2026</span>
    <h1>Style that speaks. Quality that lasts.</h1>
    <p>Discover thoughtfully selected essentials, modern accessories and everyday products designed for your lifestyle.</p>
    <a href="#products" class="primary-button">EXPLORE COLLECTION →</a>
  </div>
</section>

<section class="features">
  <div class="feature">
    <span class="feature-icon">🚚</span>
    <div><strong>Free Shipping</strong><small>On orders above ₹999</small></div>
  </div>
  <div class="feature">
    <span class="feature-icon">↩️</span>
    <div><strong>Easy Returns</strong><small>7-day return policy</small></div>
  </div>
  <div class="feature">
    <span class="feature-icon">🔒</span>
    <div><strong>Secure Shopping</strong><small>Safe demo experience</small></div>
  </div>
  <div class="feature">
    <span class="feature-icon">✦</span>
    <div><strong>Curated Products</strong><small>Selected for quality</small></div>
  </div>
</section>

<section class="section" id="products">
  <div class="section-heading">
    <div>
      <div class="eyebrow">OUR COLLECTION</div>
      <h2>Discover our products</h2>
      <p>Find something that fits your everyday style.</p>
    </div>
    <input
      class="search-box"
      id="searchInput"
      type="search"
      placeholder="Search products..."
      aria-label="Search products"
    >
  </div>

  <div class="categories" id="categories">
    <button class="category-button active" data-category="All">All Products</button>
    <button class="category-button" data-category="Fashion">Fashion</button>
    <button class="category-button" data-category="Electronics">Electronics</button>
    <button class="category-button" data-category="Accessories">Accessories</button>
    <button class="category-button" data-category="Lifestyle">Lifestyle</button>
  </div>

  <div class="product-grid" id="productGrid"></div>
</section>

<section class="promo">
  <div>
    <div class="eyebrow">A LITTLE SOMETHING FOR YOU</div>
    <h2>Make your next purchase special.</h2>
    <p>Explore our curated collection and find your next favourite.</p>
  </div>
  <div class="promo-code">WELCOME10 · DEMO OFFER</div>
</section>
</main>

<footer class="footer" id="footer">
  <div class="footer-content">
    <div>
      <h3>NEXORA<span style="color:#8b7dff">.</span></h3>
      <p>Modern essentials for modern lifestyles. A demonstration storefront powered by a locally automated DevOps infrastructure.</p>
    </div>
    <div>
      <h4>SHOP</h4>
      <a href="#products">All Products</a>
      <a href="#categories">Categories</a>
      <a href="#home">New Collection</a>
    </div>
    <div>
      <h4>INFORMATION</h4>
      <a href="#footer">About Us</a>
      <a href="#footer">Contact</a>
      <a href="#footer">Shipping Policy</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 NEXORA. Demo e-commerce storefront.</span>
    <span>Environment: {{ item.name | upper }} · Port: {{ item.port }}</span>
  </div>
</footer>

<div class="overlay" id="overlay" onclick="closeCart()"></div>

<aside class="cart-panel" id="cartPanel">
  <div class="cart-header">
    <h2>Your Shopping Cart</h2>
    <button class="close-cart" onclick="closeCart()" aria-label="Close cart">×</button>
  </div>

  <div class="cart-items" id="cartItems"></div>

  <div class="cart-footer">
    <div class="total-row">
      <span>Total</span>
      <span id="cartTotal">₹0</span>
    </div>
    <button class="primary-button checkout-button" onclick="checkout()">PROCEED TO CHECKOUT →</button>
    <p class="cart-note">Demo checkout only. No real payment will be processed.</p>
  </div>
</aside>

<div class="toast" id="toast"></div>

<script>
const products = [
